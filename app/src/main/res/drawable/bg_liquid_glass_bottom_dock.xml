<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Grounded full-width rectangle: #B30D0E15 top to #D908090D bottom vertical gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#B30D0E15"
                android:endColor="#D908090D" />
        </shape>
    </item>

    <!-- 0.8dp top specular refraction line: #1AFFFFFF -> #59FFFFFF -> #1AFFFFFF horizontal gradient -->
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#1AFFFFFF"
                android:centerColor="#59FFFFFF"
                android:endColor="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>

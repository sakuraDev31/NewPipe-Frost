<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#68FF3256"
                android:endColor="#3CE5193B" />
            <stroke
                android:width="1dp"
                android:color="#A6FF6E8E" />
            <corners android:radius="@dimen/glass_radius_full" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="@dimen/glass_radius_full"
                android:topRightRadius="@dimen/glass_radius_full" />
        </shape>
    </item>
</layer-list>

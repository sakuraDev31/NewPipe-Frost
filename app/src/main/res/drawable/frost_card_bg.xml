<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#5C232A3C"
                android:centerColor="#64121724" android:endColor="#5E1D152B" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#16FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>

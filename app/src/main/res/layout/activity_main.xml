<?xml version="1.0" encoding="utf-8"?>
<org.schabi.newpipe.views.FocusAwareDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <org.schabi.newpipe.views.FocusAwareCoordinator
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/frost_window_bg"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Full-Bleed Content Underlay: renders directly behind Top Header and Bottom Dock -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp" />

        <!-- WhatsApp iOS style sticky frosted blurred top header -->
        <include
            android:id="@+id/toolbar_layout"
            layout="@layout/toolbar_layout" />

        <!-- Connected Video Player Bottom Sheet -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_player_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|center_horizontal"
            android:elevation="14dp"
            app:behavior_hideable="true"
            app:behavior_peekHeight="0dp"
            app:layout_behavior="org.schabi.newpipe.player.gesture.CustomBottomSheetBehavior" />

        <!-- Grounded YouTube Liquid Glass Bottom Dock Bar (Portrait Mode) -->
        <org.schabi.newpipe.views.glass.RealTimeLiquidGlassView
            android:id="@+id/grounded_dock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:elevation="16dp"
            app:glassBlurRadius="28dp"
            app:glassCornerRadius="0dp"
            app:glassStrokeWidth="0.8dp"
            app:glassTint="#6610121A">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Sliding glass indicator behind active tab (spring-animated) -->
                <View
                    android:id="@+id/dock_active_indicator"
                    android:layout_width="64dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_liquid_glass_active_pill"
                    android:visibility="invisible" />

                <com.google.android.material.bottomnavigation.BottomNavigationView
                    android:id="@+id/grounded_glass_dock"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@android:color/transparent"
                    app:elevation="0dp"
                    app:itemActiveIndicatorStyle="@null"
                    app:itemIconSize="22dp"
                    app:itemIconTint="@color/selector_grounded_dock_tint"
                    app:itemRippleColor="#33FFFFFF"
                    app:itemTextAppearanceActive="@style/GroundedDockTextActive"
                    app:itemTextAppearanceInactive="@style/GroundedDockTextInactive"
                    app:itemTextColor="@color/selector_grounded_dock_tint"
                    app:labelVisibilityMode="labeled"
                    app:menu="@menu/menu_grounded_dock" />

            </FrameLayout>
        </org.schabi.newpipe.views.glass.RealTimeLiquidGlassView>

        <!-- Landscape Mode: iPhone Duo Floating Liquid Glass Navigation Rail -->
        <org.schabi.newpipe.views.glass.RealTimeLiquidGlassView
            android:id="@+id/floating_vertical_duo_pill"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:elevation="16dp"
            android:visibility="gone"
            app:glassBlurRadius="28dp"
            app:glassCornerRadius="29dp"
            app:glassStrokeWidth="1dp"
            app:glassTint="#8010121A">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp">

                <!-- Vertically sliding spring glass indicator -->
                <View
                    android:id="@+id/duo_active_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_liquid_glass_active_pill"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Home Tab -->
                    <LinearLayout
                        android:id="@+id/duo_tab_home"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/duo_icon_home"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_home"
                            app:tint="#F5F5F7" />

                        <TextView
                            android:id="@+id/duo_text_home"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tab_home"
                            android:textColor="#F5F5F7"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Subscriptions Tab -->
                    <LinearLayout
                        android:id="@+id/duo_tab_subs"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/duo_icon_subs"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_subscriptions"
                            app:tint="#A1A1AA" />

                        <TextView
                            android:id="@+id/duo_text_subs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rail_subscriptions"
                            android:textColor="#A1A1AA"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Downloads Tab -->
                    <LinearLayout
                        android:id="@+id/duo_tab_downloads"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/duo_icon_downloads"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_file_download"
                            app:tint="#A1A1AA" />

                        <TextView
                            android:id="@+id/duo_text_downloads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tab_downloads"
                            android:textColor="#A1A1AA"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Library Tab -->
                    <LinearLayout
                        android:id="@+id/duo_tab_library"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/duo_icon_library"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bookmark"
                            app:tint="#A1A1AA" />

                        <TextView
                            android:id="@+id/duo_text_library"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tab_library"
                            android:textColor="#A1A1AA"
                            android:textSize="9sp" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>
        </org.schabi.newpipe.views.glass.RealTimeLiquidGlassView>

    </org.schabi.newpipe.views.FocusAwareCoordinator>

    <include
        android:id="@+id/navigation"
        layout="@layout/drawer_layout" />

</org.schabi.newpipe.views.FocusAwareDrawerLayout>

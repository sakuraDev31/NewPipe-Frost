<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/downloads_title"
        android:textColor="@color/liquid_glass_text_title"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Storage Glass Capsule -->
    <LinearLayout
        android:id="@+id/storage_capsule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/bg_whatsapp_inset_glass_group"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device Storage"
                android:textColor="@color/liquid_glass_text_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/storage_free_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/liquid_glass_text_secondary"
                android:textSize="12sp"
                tools:text="48.2 GB free" />
        </LinearLayout>

        <!-- Multi-segment Storage Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:background="#1AFFFFFF"
            android:clipToOutline="true"
            android:orientation="horizontal">

            <View
                android:id="@+id/storage_bar_downloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:background="#FF3B5C" />

            <View
                android:id="@+id/storage_bar_other"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:background="#4DFFFFFF" />

            <View
                android:id="@+id/storage_bar_free"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"
                android:background="#1AFFFFFF" />
        </LinearLayout>

        <!-- Legend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:background="#FF3B5C" />

            <TextView
                android:id="@+id/storage_downloads_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Downloads (3.4 GB)"
                android:textColor="@color/liquid_glass_text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:background="#4DFFFFFF" />

            <TextView
                android:id="@+id/storage_other_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Other apps"
                android:textColor="@color/liquid_glass_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Frosted Filter Strip -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/download_filter_strip"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="2dp"
        android:scrollbars="none" />

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp"
            android:scrollbars="vertical" />

        <!-- Liquid Glass Empty State -->
        <LinearLayout
            android:id="@+id/download_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_glass_icon_btn">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_file_download"
                    app:tint="@color/liquid_glass_crimson_accent"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="No offline videos yet"
                android:textColor="@color/liquid_glass_text_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Videos and audio you download will appear here for offline playback"
                android:textColor="@color/liquid_glass_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

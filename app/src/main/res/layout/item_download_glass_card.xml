<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_liquid_glass_card"
    android:clipToOutline="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Thumbnail or Media Type Icon -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_glass_icon_btn">

        <ImageView
            android:id="@+id/download_item_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file_download"
            app:tint="@color/liquid_glass_crimson_accent"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/download_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/liquid_glass_text_title"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Liquid Glass Architecture Deep Dive.mp4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/download_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/liquid_glass_crimson_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="45% • 3.2 MB/s" />

            <TextView
                android:id="@+id/download_item_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/liquid_glass_text_secondary"
                android:textSize="12sp"
                tools:text="120 MB / 268 MB" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/download_item_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:progress="45"
            android:progressDrawable="@drawable/bg_mini_player_progress" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/download_btn_pause_resume"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_icon_btn"
            android:src="@drawable/ic_pause"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/download_btn_cancel"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_glass_icon_btn"
            android:src="@drawable/ic_close"
            app:tint="@color/liquid_glass_text_secondary"
            tools:ignore="ContentDescription" />
    </LinearLayout>

</LinearLayout>
